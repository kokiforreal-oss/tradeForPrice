# 复制为 .env 后修改
SECRET_KEY=please-change-this-to-a-long-random-string

# 是否开放 /api/docs（生产保持 false）
ENABLE_API_DOCS=false

# 免费社区版 MySQL 8（不要用收费云数据库 / RDS）
# 驱动为 PyMySQL。写成 mysql:// 也可以，应用会自动改成 mysql+pymysql://
# 格式：mysql+pymysql://用户:密码@主机:端口/库名?charset=utf8mb4

# 本机示例（主机 127.0.0.1，端口 3306）
DATABASE_URL=mysql+pymysql://trade:trade123@127.0.0.1:3306/trade?charset=utf8mb4

# 阿里云 ECS 上 MySQL 与应用同机时示例（把密码改成你自己设的）
# DATABASE_URL=mysql+pymysql://trade:YOUR_PASSWORD@127.0.0.1:3306/trade?charset=utf8mb4
